{
  "name": "docs-md",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-guides.mjs && node scripts/check-tool-guides.mjs && node scripts/check-discord-guides.mjs && node scripts/check-mermaid-examples.mjs && node scripts/check-i18n.mjs && node scripts/check-agent-pages.mjs && node scripts/check-llms.mjs && next build && node scripts/indexnow-ping.mjs",
    "start": "next start",
    "lint": "eslint",
    "check:tool-guides": "node scripts/check-tool-guides.mjs",
    "cleanup": "curl -X DELETE http://localhost:3000/api/cleanup",
    "type-check": "tsc --noEmit",
    "db:init": "tsx lib/init-db.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:discord-guides": "node scripts/check-discord-guides.mjs",
    "check:mermaid-examples": "node scripts/check-mermaid-examples.mjs",
    "check:guides": "node scripts/check-guides.mjs",
    "check:agent-pages": "node scripts/check-agent-pages.mjs",
    "check:llms": "node scripts/check-llms.mjs",
    "test": "tsx scripts/test-agent-policy.ts && tsx scripts/test-url-safety.ts && tsx scripts/test-handoff.ts && tsx scripts/test-json-table.ts && tsx scripts/test-markdown-dialects.ts && tsx scripts/test-inert-links.tsx",
    "test:e2e": "tsx scripts/test-agents-e2e.ts",
    "db:migrate-agents": "tsx scripts/migrate-agents.ts",
    "test:conformance": "conformance server --url ${MCP_URL:-http://localhost:3000/mcp} --scenario server-initialize && conformance server --url ${MCP_URL:-http://localhost:3000/mcp} --scenario ping && conformance server --url ${MCP_URL:-http://localhost:3000/mcp} --scenario tools-list"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^2.0.0",
    "@vercel/postgres": "^0.10.0",
    "github-slugger": "^2.0.0",
    "jspdf": "^3.0.3",
    "mcp-handler": "^2.4.0",
    "mermaid": "^11.16.1",
    "nanoid": "^5.1.6",
    "next": "16.0.10",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "^0.1.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
